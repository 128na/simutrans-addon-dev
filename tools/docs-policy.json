{
  "$comment": "docs-lint の設定。検査するのはリポジトリ直下と docs/ の md。livingDocs は常に最新に保つ文書の allowlist で、足すときは理由を docs/adr/ に書く（docs/reference/ は ADR 0001）。規約は docs/README.md。",
  "scanRoots": {
    "recursive": [
      "docs"
    ],
    "flat": [
      "."
    ]
  },
  "ledgers": [
    "docs/dependency-debt.md"
  ],
  "recordDirs": [
    "docs/records"
  ],
  "adrDir": "docs/adr",
  "templateDir": "docs/templates",
  "forbiddenFileNames": [
    "INDEX.md",
    "index.md",
    "TODO.md"
  ],
  "forbiddenDirNames": [
    "temp",
    "tmp",
    "draft",
    "wip"
  ],
  "dependencyDebtHeader": "| Package | Current | Target | Blocker | Type | Revisit condition | Recorded |",
  "dependencyDebtTypes": [
    "temporary",
    "infra",
    "behavior-change"
  ],
  "livingDocs": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "docs/README.md",
    "docs/reference/way-addon.md"
  ]
}
