# Blender 検証用の線路の橋の試作: 基盤・欄干・橋脚・端の坂の躯体。絵の位置は調整していない
# 端の坂（Ramp）の向きは「坂の高い側」: Ramp[N] は北が高い坂の絵（本体の slope_t::north は南が高い坂で、S の絵を使う）
obj=bridge
name=bpoc_track_bridge
copyright=blender-poc
waytype=track
cost=40000
maintenance=1000
topspeed=100
max_lenght=16
intro_year=1900
intro_month=1
retire_year=2999
retire_month=1
pillar_distance=1
icon=> track_bridge.0.0
cursor=track_bridge.0.1,-64,-32
