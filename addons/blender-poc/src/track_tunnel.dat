# Blender 検証用の線路のトンネルの試作: 坑口の躯体（手前の絵）と、線路・暗い内側（奥の絵）
obj=tunnel
name=bpoc_track_tunnel
copyright=blender-poc
waytype=track
way=bpoc_track
cost=50000
maintenance=1000
topspeed=100
intro_year=1900
intro_month=1
retire_year=2999
retire_month=1
icon=> track_tunnel.0.0
cursor=track_tunnel.0.1,-64,-32
BackImage[N][0]=track_tunnel.0.2,-64,-32
FrontImage[N][0]=track_tunnel.1.2,-64,-32
BackImage[S][0]=track_tunnel.0.3,-64,-32
FrontImage[S][0]=track_tunnel.1.3,-64,-32
BackImage[E][0]=track_tunnel.0.4,-64,-32
FrontImage[E][0]=track_tunnel.1.4,-64,-32
BackImage[W][0]=track_tunnel.0.5,-64,-32
FrontImage[W][0]=track_tunnel.1.5,-64,-32
BackImage[N][1]=track_tunnel.2.2,-64,-32
FrontImage[N][1]=track_tunnel.3.2,-64,-32
BackImage[S][1]=track_tunnel.2.3,-64,-32
FrontImage[S][1]=track_tunnel.3.3,-64,-32
BackImage[E][1]=track_tunnel.2.4,-64,-32
FrontImage[E][1]=track_tunnel.3.4,-64,-32
BackImage[W][1]=track_tunnel.2.5,-64,-32
