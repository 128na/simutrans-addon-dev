# Blender 検証用の高速道路（歩道なし）。SIS の高速道路 SIS_E_RG1-1_01S に合わせる。
# カーブは SIS と同じく、同じ向きの斜めの絵を使う
obj=way
name=bpoc_expressway
copyright=blender-poc
intro_year=1900
intro_month=1
retire_year=2999
retire_month=1
waytype=road
cost=45900
maintenance=1480
topspeed=120
system_type=0
icon=> expressway.0.0
cursor=expressway.0.1,-64,-32
image[ns][0]=expressway.0.2,-64,-32
image[ew][0]=expressway.0.3,-64,-32
image[s][0]=expressway.0.5,-64,-32
image[w][0]=expressway.0.6,-64,-32
image[n][0]=expressway.0.7,-64,-32
image[e][0]=expressway.0.8,-64,-32
image[-][0]=expressway.0.9,-64,-32
imageup[12][0]=expressway.1.0,-64,-32
imageup[9][0]=expressway.1.1,-64,-32
imageup[3][0]=expressway.1.2,-64,-32
imageup[6][0]=expressway.1.3,-64,-32
imageup2[12][0]=expressway.1.5,-64,-32
imageup2[9][0]=expressway.1.6,-64,-32
imageup2[3][0]=expressway.1.7,-64,-32
imageup2[6][0]=expressway.1.8,-64,-32
diagonal[sw][0]=expressway.2.0,-64,-32
diagonal[nw][0]=expressway.2.1,-64,-32
diagonal[ne][0]=expressway.2.2,-64,-32
diagonal[se][0]=expressway.2.3,-64,-32
diagonal[close1][0]=expressway.2.4,-64,-32
diagonal[close2][0]=expressway.2.9,-64,-32
image[sw][0]=expressway.2.0,-64,-32
