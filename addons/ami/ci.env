# CI（.github/workflows/addon-ami.yml）が使う道具の版。取り方は tools/ci/ のスクリプト。
# MAKEOBJ: upstream:<本家のリリースのタグ> か otrp:<128na/simutrans のタグかコミット>
#   本家 125.0 の Linux 版は 60.10（手元の Windows 版は 60.12）。今の OTRP の fork の makeobj（60.5）は
#   近い斜めのキーを知らず AMI を作れない（tools/README.md の「CI の道具」）
MAKEOBJ=upstream:125.0
DAT_LINTER=v0.3.1
RUFF=0.14.0
# HEADLESS_SIM: 画面を出さない本体（BACKEND=posix）を取るソース。otrp:<128na/simutrans のコミット>。本体の tests/simutrans-test-base.zip が pakset
HEADLESS_SIM=otrp:0ef69091f17512d449ca5db4f6570536c56dd9d8
